# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Database (SQLite file by default; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
# Comma separated list, e.g. transactions,auth,identity,liabilities
PLAID_PRODUCTS=transactions,liabilities,auth
PLAID_COUNTRY_CODES=US

# Email alerts (optional - leave blank to disable email alerts, in-app alerts always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alerts@yourbudgetapp.com
